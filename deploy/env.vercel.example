# Vercel project environment variables (Production scope). Not a file Vercel reads: enter
# each in the dashboard. See VERCEL.md. Supabase passwords: letters and digits only.

# Transaction pooler (port 6543): the app. The client uses prepare: false for it.
DATABASE_URL=postgres://postgres.PROJECT_REF:CHANGE_ME@aws-0-us-east-1.pooler.supabase.com:6543/postgres
# Session pooler (port 5432): migrations and seeding in the production build.
MIGRATION_DATABASE_URL=postgres://postgres.PROJECT_REF:CHANGE_ME@aws-0-us-east-1.pooler.supabase.com:5432/postgres

ORIGIN=https://PROJECT_NAME.vercel.app
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=CHANGE_ME

PUBLIC_MAP_DEFAULT_EXTENT=conus
PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron

# Not on Vercel: ADDRESS_HEADER / XFF_DEPTH (Vercel resolves the client address),
# HOST / PORT, BODY_SIZE_LIMIT (adapter-node only; Vercel's own limit is 4.5 MB).
