# ~/blightmap/shared/.env on the server (chmod 600). Read by the service and by
# deploy.sh's migrate/seed steps. Plain KEY=value lines: systemd reads this file too.

DATABASE_URL=postgres://blightmap:CHANGE_ME@127.0.0.1:5432/blightmap_staging
ORIGIN=https://blightmap.dev.agweather.cals.wisc.edu
# node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=CHANGE_ME

HOST=127.0.0.1
PORT=3100
# Set by nginx (proxy_set_header X-Real-IP $remote_addr); the rate limits key on it.
ADDRESS_HEADER=X-Real-IP

PUBLIC_MAP_DEFAULT_EXTENT=conus
PUBLIC_BASEMAP_STYLE_URL=https://tiles.openfreemap.org/styles/positron
