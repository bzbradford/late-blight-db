# Database
DATABASE_URL="postgres://user@localhost/lateblight_dev"

# Public origin of the app (used by Better Auth and adapter-node)
ORIGIN="http://localhost:5173"

# Better Auth — 32 bytes of entropy. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""

# Default map extent: `conus` (default) or `upper-midwest`. The extent is a minimum —
# the view widens automatically if detections fall outside it.
PUBLIC_MAP_DEFAULT_EXTENT="conus"

# Basemap vector tile style. Unset renders counties with no basemap underneath,
# which is a supported mode — the basemap is geographic context only.
PUBLIC_BASEMAP_STYLE_URL="https://tiles.openfreemap.org/styles/positron"
