# Database
DATABASE_URL="postgres://user@localhost/lateblight_dev"

# Public origin of the app (used by Better Auth and adapter-node)
ORIGIN="http://localhost:5173"

# Better Auth — 32 bytes of entropy. Generate a fresh one per environment:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
BETTER_AUTH_SECRET=""

# Default map extent: `conus` (default) or `upper-midwest`. The extent is a minimum —
# the view widens automatically if detections fall outside it.
PUBLIC_MAP_DEFAULT_EXTENT="conus"

# Basemap vector tile style. Unset uses OpenFreeMap Positron. Set to "" to render
# counties with no basemap underneath, which is a supported mode — the basemap is
# geographic context only.
PUBLIC_BASEMAP_STYLE_URL="https://tiles.openfreemap.org/styles/positron"
# Dark-mode basemap. Unset: OpenFreeMap's dark style if the light one is also the default,
# otherwise the light style is reused. Ignored when PUBLIC_BASEMAP_STYLE_URL is empty.
# PUBLIC_BASEMAP_STYLE_URL_DARK="https://tiles.openfreemap.org/styles/dark"

# Behind the reverse proxy: where the real client address is. Sign-in rate limits (the
# form's and Better Auth's) are per client, so without this every visitor looks like the
# proxy and one person's wrong passwords lock everyone out. Use one or the other:
#   ADDRESS_HEADER="X-Real-IP"          # a header the proxy sets to the client address
#   ADDRESS_HEADER="X-Forwarded-For"    # with XFF_DEPTH = number of trusted proxies
#   XFF_DEPTH=1

# Largest request body adapter-node accepts (default 512K). The CSV import posts files up
# to 400 KB and then the same text again on confirm, so the default is enough; raise it
# only together with MAX_IMPORT_BYTES in src/lib/server/import.ts.
# BODY_SIZE_LIMIT=512K
